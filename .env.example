# The local web app defaults to this URL. Override only if the API runs elsewhere.
NEXT_PUBLIC_API_URL=http://localhost:8000

# API CORS configuration. Comma-separated list of allowed origins.
# CORS_ORIGINS=http://localhost:3000,https://my-production-domain.com

# Optional live Strands/Bedrock mode. Deterministic local remains the default.
# Standard AWS credentials should be configured via ~/.aws/credentials or IAM Task Roles (do not commit them).
# CANDIDATELOOP_EXECUTION_MODE=strands
# CANDIDATELOOP_MODEL_PROVIDER=bedrock
# AWS_REGION=us-west-2
# CANDIDATELOOP_MODEL_ID=us.amazon.nova-lite-v1:0

# Alternate provider: OpenRouter through the Strands OpenAI provider. No AWS settings are needed.
# CANDIDATELOOP_EXECUTION_MODE=strands
# CANDIDATELOOP_MODEL_PROVIDER=openrouter
# CANDIDATELOOP_MODEL_ID=openai/gpt-4o-mini
# OPENROUTER_API_KEY=<do not commit>
