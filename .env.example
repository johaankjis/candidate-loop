# The local web app defaults to this URL. Override only if the API runs elsewhere.
NEXT_PUBLIC_API_URL=http://localhost:8000

# API CORS configuration. Comma-separated list of allowed origins.
# CORS_ORIGINS=http://localhost:3000,https://my-production-domain.com

# AWS Configuration (Required for Strands/Bedrock runtime)
# Standard AWS credentials should be configured via ~/.aws/credentials or IAM Task Roles (do not commit them).
AWS_REGION=us-west-2

# Strands execution mode configuration
# Set to 'strands' to run the model-driven agent, or 'deterministic_local' for local testing
CANDIDATELOOP_EXECUTION_MODE=deterministic_local
CANDIDATELOOP_MODEL_PROVIDER=bedrock
CANDIDATELOOP_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

