# CandidateLoop web app environment.
#
# vinext loads .env files relative to this directory (apps/web), NOT the repo
# root, so the root .env.example does not configure the frontend. Copy this file
# to apps/web/.env.local for local overrides.
#
# NEXT_PUBLIC_* values are INLINED INTO THE CLIENT BUNDLE AT BUILD TIME. Setting
# this only in the runtime environment has no effect on an already-built app --
# it must be present when `npm run build` runs.
#
# When unset, the app falls back to http://localhost:8000, which is what local
# development wants.
NEXT_PUBLIC_API_URL=http://localhost:8000
